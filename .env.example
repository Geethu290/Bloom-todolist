# Server Port
PORT=3000

# MongoDB Connection String
# Option 1: Local MongoDB instance (default)
MONGODB_URI=mongodb://127.0.0.1:27017/bloom_db

# Option 2: MongoDB Atlas Cloud instance (uncomment and replace credentials)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bloom_db?retryWrites=true&w=majority

# Session Secret Key (use a long, random string in production)
SESSION_SECRET=your_super_secret_session_key_here
